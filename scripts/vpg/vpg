#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 077

readonly VPG_VERSION="1.0.0"
# Resolve through symlinks so an installed PATH entry still finds src/.
readonly VPG_ROOT="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
readonly BACKUP_COMMAND="${VPG_ROOT}/src/backup.sh"
readonly RESTORE_COMMAND="${VPG_ROOT}/src/restore.sh"

usage() {
  cat <<EOF
vpg ${VPG_VERSION} - secure PostgreSQL backup and recovery for Docker

Usage:
  vpg backup <output-directory> [options]
  vpg restore <backup-directory|archive.tar.gz> [options]
  vpg verify <backup-directory|archive.tar.gz>
  vpg list [backup-directory]
  vpg version
  vpg help [command]

Commands:
  backup    Create and validate a full logical cluster backup.
  restore   Replace a container's cluster from a VPG backup.
  verify    Verify structure, inventory, and SHA-256 checksums.
  list      List complete backups (default: current directory).
  version   Print the installed VPG version.

Run 'vpg help <command>' for command-specific help.
EOF
}

fatal() {
  printf 'vpg: error: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 ||
    fatal "required command not found: $1"
}

manifest_value() {
  local file="$1"
  local key="$2"
  awk -F= -v key="${key}" '$1 == key { sub(/^[^=]*=/, ""); value=$0 } END { print value }' "${file}"
}

verify_directory() {
  local directory="$1"
  local quiet="${2:-false}"

  [[ -d "${directory}" ]] || fatal "backup directory not found: ${directory}"
  [[ ! -L "${directory}" ]] || fatal "backup directory must not be a symbolic link"

  local required
  for required in manifest.txt globals.sql database-map.tsv FILES.txt SHA256SUMS BACKUP_COMPLETE; do
    [[ -f "${directory}/${required}" ]] ||
      fatal "missing required backup file: ${required}"
    [[ ! -L "${directory}/${required}" ]] ||
      fatal "backup file must not be a symbolic link: ${required}"
  done

  [[ "$(manifest_value "${directory}/manifest.txt" backup_format_version)" == "1" ]] ||
    fatal "unsupported or missing backup format version"
  [[ "$(manifest_value "${directory}/manifest.txt" status)" == "complete" ]] ||
    fatal "backup manifest is not complete"

  local unexpected
  local actual_inventory
  local expected_inventory
  unexpected="$(
    find "${directory}" -mindepth 1 -maxdepth 1 ! -type f -print -quit
  )"
  [[ -z "${unexpected}" ]] ||
    fatal "unexpected non-regular backup entry: ${unexpected}"

  awk '
    NF == 0 || /^\// || /(^|\/)\.\.(\/|$)/ || index($0, "/") {
      print "unsafe inventory entry at line " NR ": " $0 > "/dev/stderr"
      exit 1
    }
  ' "${directory}/FILES.txt" ||
    fatal "backup inventory contains unsafe paths"

  actual_inventory="$(
    find "${directory}" -mindepth 1 -maxdepth 1 -type f \
      ! -name FILES.txt \
      ! -name SHA256SUMS \
      ! -name BACKUP_COMPLETE \
      ! -name BACKUP_FAILED \
      -printf '%f\n' |
      LC_ALL=C sort
  )"
  expected_inventory="$(LC_ALL=C sort -- "${directory}/FILES.txt")"
  [[ "${actual_inventory}" == "${expected_inventory}" ]] ||
    fatal "file inventory does not match backup contents"

  (
    cd -- "${directory}"
    sha256sum --check --strict --quiet -- SHA256SUMS
  ) || fatal "backup integrity verification failed"

  local expected_count
  local actual_count
  expected_count="$(manifest_value "${directory}/manifest.txt" database_count)"
  [[ "${expected_count}" =~ ^[1-9][0-9]*$ ]] ||
    fatal "invalid database count in manifest"
  actual_count="$(
    awk -F '\t' 'NR > 1 && NF == 2 { count++ } END { print count + 0 }' \
      "${directory}/database-map.tsv"
  )"
  [[ "${actual_count}" == "${expected_count}" ]] ||
    fatal "database map count does not match manifest"

  while IFS=$'\t' read -r dump_file encoded_name extra; do
    [[ "${dump_file}" == "dump_file" ]] && continue
    [[ -n "${dump_file}" && -n "${encoded_name}" && -z "${extra:-}" ]] ||
      fatal "invalid database map entry"
    [[ "${dump_file}" =~ ^database_[0-9]{4}\.dump$ ]] ||
      fatal "unsafe database dump name: ${dump_file}"
    [[ -s "${directory}/${dump_file}" ]] ||
      fatal "database dump is missing or empty: ${dump_file}"
    printf '%s' "${encoded_name}" | base64 --decode >/dev/null 2>&1 ||
      fatal "invalid encoded database name for ${dump_file}"
  done < "${directory}/database-map.tsv"

  if [[ "${quiet}" != true ]]; then
    printf 'Backup verified: %s\n' "${directory}"
    printf 'Backup ID:       %s\n' \
      "$(manifest_value "${directory}/manifest.txt" backup_id)"
    printf 'Databases:       %s\n' "${actual_count}"
    printf 'Completed:       %s\n' \
      "$(manifest_value "${directory}/manifest.txt" completed_at)"
  fi
}

validate_archive_paths() {
  local archive="$1"
  local entry
  local root=""

  while IFS= read -r entry; do
    entry="${entry%/}"
    [[ -n "${entry}" ]] || continue
    [[ "${entry}" != /* && "${entry}" != *\\* ]] ||
      fatal "archive contains an unsafe absolute path"
    [[ "${entry}" != ".." && "${entry}" != ../* && "${entry}" != */../* && "${entry}" != */.. ]] ||
      fatal "archive contains path traversal"

    if [[ -z "${root}" ]]; then
      root="${entry%%/*}"
    fi
    [[ "${entry}" == "${root}" || "${entry}" == "${root}/"* ]] ||
      fatal "archive must contain exactly one top-level backup directory"
  done < <(tar --list --gzip --file="${archive}")

  [[ -n "${root}" && "${root}" != "." ]] ||
    fatal "archive is empty or has an invalid root directory"
  printf '%s' "${root}"
}

verify_archive() {
  local archive="$1"
  [[ -f "${archive}" && -s "${archive}" ]] ||
    fatal "backup archive not found or empty: ${archive}"
  [[ ! -L "${archive}" ]] || fatal "backup archive must not be a symbolic link"

  require_command tar
  require_command gzip
  gzip --test -- "${archive}" || fatal "archive compression validation failed"

  if [[ -f "${archive}.sha256" ]]; then
    (
      cd -- "$(dirname -- "${archive}")"
      sha256sum --check --strict -- "$(basename -- "${archive}.sha256")"
    ) >/dev/null || fatal "archive SHA-256 checksum verification failed"
  fi

  local root
  root="$(validate_archive_paths "${archive}")"
  local temporary_directory
  temporary_directory="$(mktemp -d)"
  trap 'rm -rf -- "${temporary_directory}"' RETURN
  tar --extract --gzip --file="${archive}" --directory="${temporary_directory}" \
    --no-same-owner --no-same-permissions
  verify_directory "${temporary_directory}/${root}" false
  rm -rf -- "${temporary_directory}"
  trap - RETURN
}

list_backups() {
  local root="${1:-.}"
  [[ -d "${root}" ]] || fatal "backup directory not found: ${root}"

  printf '%-42s  %-20s  %s\n' "BACKUP ID" "COMPLETED (UTC)" "DATABASES"
  local directory
  local found=false
  while IFS= read -r -d '' directory; do
    if verify_directory "${directory}" true 2>/dev/null; then
      printf '%-42s  %-20s  %s\n' \
        "$(manifest_value "${directory}/manifest.txt" backup_id)" \
        "$(manifest_value "${directory}/manifest.txt" completed_at)" \
        "$(manifest_value "${directory}/manifest.txt" database_count)"
      found=true
    fi
  done < <(find "${root}" -mindepth 1 -maxdepth 1 -type d -print0 | LC_ALL=C sort -z)

  if [[ "${found}" == false ]]; then
    printf '(no complete VPG backups found)\n'
  fi
}

main() {
  local command="${1:-help}"
  [[ $# -eq 0 ]] || shift

  case "${command}" in
    backup)
      [[ -f "${BACKUP_COMMAND}" ]] ||
        fatal "backup command is missing: ${BACKUP_COMMAND}"
      VPG_PROGRAM="vpg backup" exec bash -- "${BACKUP_COMMAND}" "$@"
      ;;
    restore)
      [[ -f "${RESTORE_COMMAND}" ]] ||
        fatal "restore command is missing: ${RESTORE_COMMAND}"
      VPG_PROGRAM="vpg restore" exec bash -- "${RESTORE_COMMAND}" "$@"
      ;;
    verify)
      [[ $# -eq 1 ]] || fatal "usage: vpg verify <backup-directory|archive.tar.gz>"
      require_command awk
      require_command base64
      require_command find
      require_command sha256sum
      require_command sort
      require_command mktemp
      if [[ -d "$1" ]]; then
        verify_directory "$1" false
      else
        verify_archive "$1"
      fi
      ;;
    list)
      [[ $# -le 1 ]] || fatal "usage: vpg list [backup-directory]"
      require_command awk
      require_command base64
      require_command find
      require_command sha256sum
      require_command sort
      list_backups "${1:-.}"
      ;;
    version|--version|-V)
      [[ $# -eq 0 ]] || fatal "version does not accept arguments"
      printf 'vpg %s\n' "${VPG_VERSION}"
      ;;
    help|--help|-h)
      if [[ $# -eq 0 ]]; then
        usage
      elif [[ $# -eq 1 ]]; then
        case "$1" in
          backup) VPG_PROGRAM="vpg backup" exec bash -- "${BACKUP_COMMAND}" --help ;;
          restore) VPG_PROGRAM="vpg restore" exec bash -- "${RESTORE_COMMAND}" --help ;;
          verify) printf 'Usage: vpg verify <backup-directory|archive.tar.gz>\n' ;;
          list) printf 'Usage: vpg list [backup-directory]\n' ;;
          *) fatal "unknown command: $1" ;;
        esac
      else
        fatal "usage: vpg help [command]"
      fi
      ;;
    *)
      fatal "unknown command '${command}'; run 'vpg --help'"
      ;;
  esac
}

main "$@"
